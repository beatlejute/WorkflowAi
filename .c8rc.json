{
  "all": true,
  "provider": "v8",
  "reporter": [
    "text",
    "text-summary",
    "json",
    "json-summary",
    "html"
  ],
  "report-dir": "coverage",
  "temp-dir": ".nyc_output",
  "check-coverage": false,
  "exclude": [
    "coverage/**",
    ".nyc_output/**",
    "node_modules/**",
    "src/tests/**",
    "**/*.test.mjs",
    ".workflow/**",
    "src/skills/**",
    "src/cli.mjs",
    "src/init.mjs",
    "src/runner.mjs",
    "src/wf-loader.mjs",
    "src/global-dir.mjs",
    "src/junction-manager.mjs",
    "src/lib/**",
    "bin/**",
    ".stryker-tmp/**",
    "test_snippet.mjs",
    "scripts/**",
    "**/*.test.js"
  ],
  "extension": [
    ".js",
    ".mjs"
  ]
}
