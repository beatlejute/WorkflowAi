{
  "name": "workflow-ai",
  "version": "1.7.2",
  "description": "AI Agent Workflow Coordinator — kanban-based pipeline for AI coding agents",
  "type": "module",
  "bin": {
    "workflow": "bin/workflow.mjs"
  },
  "files": [
    "bin/",
    "src/cli.mjs",
    "src/init.mjs",
    "src/runner.mjs",
    "src/wf-loader.mjs",
    "src/global-dir.mjs",
    "src/junction-manager.mjs",
    "src/rails/",
    "src/lib/",
    "src/scripts/*.js",
    "src/skills/*/SKILL.md",
    "src/skills/*/index.mjs",
    "templates/",
    "configs/",
    "agent-templates/",
    "CHANGELOG.md"
  ],
  "exports": {
    "./lib/find-root.mjs": "./src/lib/find-root.mjs",
    "./lib/utils.mjs": "./src/lib/utils.mjs",
    "./lib/logger.mjs": "./src/lib/logger.mjs",
    "./lib/js-yaml.mjs": "./src/lib/js-yaml.mjs",
    "./lib/operations/tickets.mjs": "./src/lib/operations/tickets.mjs",
    "./lib/operations/plans.mjs": "./src/lib/operations/plans.mjs",
    "./lib/operations/skills.mjs": "./src/lib/operations/skills.mjs"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "test": "node --test --import ./src/tests/_rails-home.mjs src/tests/*.test.mjs src/skills/*/tests/rails/*.test.mjs",
    "test:rails-guards": "node --test --import ./src/tests/_rails-home.mjs src/skills/*/tests/rails/*.test.mjs",
    "bench": "node --test src/tests/artifact-snapshot.bench.mjs",
    "bench:perf": "node --test --test-concurrency=1 --test-timeout=120000 src/tests/perf-approval-hook-latency.bench.mjs src/tests/perf-mark-blocked-latency.bench.mjs src/tests/perf-pick-next-task-large-backlog.bench.mjs",
    "test:skills": "node src/scripts/run-skill-tests.js --all",
    "coverage": "c8 node --test src/tests/*.test.mjs && node scripts/check-coverage-ratchet.mjs",
    "coverage:mark-blocked": "c8 node --test src/tests/scripts-mark-blocked.test.mjs",
    "coverage:pick-next-task": "node scripts/coverage-pick-next-task.js",
    "coverage:move-ticket": "c8 node --test src/tests/scripts-move-ticket-approval-hook.test.mjs",
    "release": "npm version patch && git push --follow-tags"
  },
  "dependencies": {
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/javascript-mutator": "^4.0.0",
    "c8": "^11.0.0"
  }
}
